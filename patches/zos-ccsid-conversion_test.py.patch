+def get_tags(path):
+    """Returns dict with 'ccsid' and 'txtflag' keys."""
+    proc = subprocess.run(['chtag', '-h', '-p', str(path)], capture_output=True, text=True)
+    if proc.returncode != 0:
+        return {'ccsid': 'untagged', 'txtflag': '0'}
+    
+    txt = "1" if "T=on" in proc.stdout else "0"
+    words = proc.stdout.strip().split()
+    ccsid = words[1] if len(words) >= 2 else 'untagged'
+    
+    return {'ccsid': ccsid, 'txtflag': txt}
+
+
+def verify_content(path, expected_lines):
+    """Verify file content matches expected lines."""
+    with open(path, 'r', encoding='latin-1') as f:
+        actual = f.read().strip().split('\n')
+    
+    if len(actual) != len(expected_lines):
+        print(f"Expected {len(expected_lines)} lines, got {len(actual)} lines")
+        return False
+    
+    for i, (actual_line, expected_line) in enumerate(zip(actual, expected_lines)):
+        if actual_line != expected_line:
+            print(f"Line {i+1} mismatch:")
+            print(f"  Expected: {repr(expected_line)}")
+            print(f"  Actual:   {repr(actual_line)}")
+            return False
+    
+    return True
+
+
+def hex_dump(path, max_bytes=256):
+    """Return hex dump of file for debugging."""
+    with open(path, 'rb') as f:
+        data = f.read(max_bytes)
+    return ' '.join(f'{b:02x}' for b in data)
