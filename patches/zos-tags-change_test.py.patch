+#!/usr/bin/env python3
+# Test rsync preservation of z/OS file tags when only tags change
+
+import os
+import platform
+import shutil
+import subprocess
+
+from rsyncfns import (
+    FROMDIR, RSYNC, SCRATCHDIR, TODIR,
+    makepath, rsync_argv, run_rsync, test_fail, test_skipped,
+)
+
+if platform.system() != 'OS/390':
+    test_skipped("Skipping z/OS tags test on non-z/OS system")
+
+if shutil.which('chtag') is None:
+    test_skipped("Skipping z/OS tags test: chtag command not found")
+
+
+def get_tags(path):
+    """Returns 'ccsid txtflag' string, e.g. 'ISO8859-1 1'."""
+    proc = subprocess.run(['chtag', '-p', str(path)], capture_output=True, text=True)
+    if proc.returncode != 0:
+        return ""
+    txt = "1" if "T=on" in proc.stdout else "0"
+    words = proc.stdout.strip().split()
+    if len(words) >= 2:
+        return f"{words[1]} {txt}"
+    return ""
+
+
+makepath(FROMDIR, TODIR)
+
+file819 = FROMDIR / 'file819'
+file819.write_text("text file 819\n")
+subprocess.run(['chtag', '-t', '-c', '819', str(file819)], check=True)
+
+# Detect tag change only
+run_rsync('-av', '--zos-tags', f'{FROMDIR}/', f'{TODIR}/', check=True)
+print(f"Before chtag source: {get_tags(file819)}")
+print(f"Before chtag dest: {get_tags(TODIR / 'file819')}")
+
+subprocess.run(['chtag', '-t', '-c', '1047', str(file819)], check=True)
+print(f"After chtag source: {get_tags(file819)}")
+
+proc = subprocess.run(
+    rsync_argv('-rivvvI', '--zos-tags', f'{FROMDIR}/', f'{TODIR}/'),
+    capture_output=True, text=True
+)
+(SCRATCHDIR / 'test4.log').write_text(proc.stdout + proc.stderr)
+print(proc.stdout)
+
+tag819 = get_tags(TODIR / 'file819')
+print(f"file819 (updated tag): {tag819}")
+if "IBM-1047 1" not in tag819:
+    test_fail("Destination tag not updated to IBM-1047 1")
