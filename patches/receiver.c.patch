+#ifdef __MVS__
+#ifdef ICONV_CONST
+/* iconv handle for z/OS CCSID conversion */
+static int zos_source_ccsid = 819; /* ASCII by default */
+
+/* Convert data from source CCSID to target CCSID for z/OS */
+/* Convert a complete file to target z/OS CCSID after reconstruction.
+ * This avoids issues with:
+ * - Multibyte sequences split across rsync literal blocks
+ * - Conversion state being reset between blocks
+ * - Matched blocks bypassing conversion
+ * Returns 0 on success, -1 on error. */
+static int convert_file_zos_ccsid(int fd, const char *fname, OFF_T file_length, int target_ccsid)
+{
+        char ccsid_from[32], ccsid_to[32];
+        char *read_buf = NULL, *converted_buf = NULL;
+        size_t inleft, outleft, converted_total = 0;
+        char *inbuf, *outbuf;
+        ssize_t nread;
+        OFF_T offset = 0;
+        int temp_fd = -1;
+        char temp_fname[MAXPATHLEN];
+        int ret = -1;
+        iconv_t converter = (iconv_t)-1;
+        size_t read_chunk = 64 * 1024; /* 64KB chunks */
+        size_t converted_size;
+
+        (void)file_length; /* Used for validation/progress in future */
+
+        if (target_ccsid == 0 || target_ccsid == 819 || target_ccsid == 1208) {
+                /* No conversion needed for ASCII or UTF-8 */
+                return 0;
+        }
+
+        /* Setup iconv for CCSID conversion */
+        if (zos_source_ccsid == 819) {
+                snprintf(ccsid_from, sizeof(ccsid_from), "ISO8859-1");
+        } else {
+                snprintf(ccsid_from, sizeof(ccsid_from), "IBM-%d", zos_source_ccsid);
+        }
+
+        if (target_ccsid == 819) {
+                snprintf(ccsid_to, sizeof(ccsid_to), "ISO8859-1");
+        } else {
+                snprintf(ccsid_to, sizeof(ccsid_to), "IBM-%d", target_ccsid);
+        }
+
+        converter = iconv_open(ccsid_to, ccsid_from);
+        if (converter == (iconv_t)-1) {
+                rsyserr(FERROR_XFER, errno, "iconv_open(\"%s\", \"%s\") failed for z/OS CCSID conversion on %s",
+                        ccsid_to, ccsid_from, full_fname(fname));
+                return -1;
+        }
+
+        /* Create temporary file for converted data */
+        snprintf(temp_fname, sizeof(temp_fname), "%s.ccsid-convert-XXXXXX", fname);
+        temp_fd = do_mkstemp(temp_fname, 0600);
+        if (temp_fd < 0) {
+                rsyserr(FERROR_XFER, errno, "mkstemp failed for CCSID conversion temp file %s", temp_fname);
+                goto cleanup;
+        }
+
+        /* Allocate buffers */
+        read_buf = new_array(char, read_chunk);
+        /* Worst case: 4x expansion for multibyte */
+        converted_buf = new_array(char, read_chunk * 4);
+
+        /* Rewind source file */
+        if (do_lseek(fd, 0, SEEK_SET) != 0) {
+                rsyserr(FERROR_XFER, errno, "lseek failed during CCSID conversion of %s", full_fname(fname));
+                goto cleanup;
+        }
+
+        /* Convert file in chunks, maintaining iconv state across chunks */
+        while ((nread = read(fd, read_buf, read_chunk)) > 0) {
+                inbuf = read_buf;
+                inleft = nread;
+
+                /* Convert this chunk */
+                while (inleft > 0) {
+                        outbuf = converted_buf;
+                        outleft = read_chunk * 4;
+
+                        size_t result = iconv(converter, &inbuf, &inleft, &outbuf, &outleft);
+                        converted_size = (read_chunk * 4) - outleft;
+
+                        if (result == (size_t)-1) {
+                                if (errno == E2BIG) {
+                                        /* Output buffer full, write and continue */
+                                } else if (errno == EINVAL) {
+                                        /* Incomplete multibyte sequence at end of chunk.
+                                         * This is OK if we're not at EOF; will be completed in next chunk.
+                                         * Save incomplete bytes for next iteration. */
+                                        if (inleft > 0 && inleft < 16) {
+                                                /* Save incomplete bytes, write converted data, continue */
+                                                break;
+                                        }
+                                        rsyserr(FERROR_XFER, errno, "iconv EINVAL with %zu bytes remaining during conversion of %s",
+                                                inleft, full_fname(fname));
+                                        goto cleanup;
+                                } else if (errno == EILSEQ) {
+                                        rsyserr(FERROR_XFER, errno, "iconv illegal sequence at offset %lld during conversion of %s",
+                                                (long long)offset, full_fname(fname));
+                                        goto cleanup;
+                                } else {
+                                        rsyserr(FERROR_XFER, errno, "iconv conversion failed at offset %lld for %s",
+                                                (long long)offset, full_fname(fname));
+                                        goto cleanup;
+                                }
+                        }
+
+                        /* Write converted data */
+                        if (converted_size > 0) {
+                                if (write(temp_fd, converted_buf, converted_size) != (ssize_t)converted_size) {
+                                        rsyserr(FERROR_XFER, errno, "write failed during CCSID conversion of %s", full_fname(fname));
+                                        goto cleanup;
+                                }
+                                converted_total += converted_size;
+                        }
+                }
+
+                offset += nread;
+        }
+
+        if (nread < 0) {
+                rsyserr(FERROR_XFER, errno, "read failed during CCSID conversion of %s", full_fname(fname));
+                goto cleanup;
+        }
+
+        /* Flush any remaining converted data */
+        outbuf = converted_buf;
+        outleft = read_chunk * 4;
+        if (iconv(converter, NULL, NULL, &outbuf, &outleft) == (size_t)-1) {
+                rsyserr(FERROR_XFER, errno, "iconv flush failed during conversion of %s", full_fname(fname));
+                goto cleanup;
+        }
+        converted_size = (read_chunk * 4) - outleft;
+        if (converted_size > 0) {
+                if (write(temp_fd, converted_buf, converted_size) != (ssize_t)converted_size) {
+                        rsyserr(FERROR_XFER, errno, "write failed during CCSID conversion flush of %s", full_fname(fname));
+                        goto cleanup;
+                }
+                converted_total += converted_size;
+        }
+
+        /* z/OS-specific newline fix for IBM-1047 */
+        if (target_ccsid == 1047) {
+                /* Read back and fix newlines */
+                if (do_lseek(temp_fd, 0, SEEK_SET) != 0) {
+                        rsyserr(FERROR_XFER, errno, "lseek failed during newline fix for %s", full_fname(fname));
+                        goto cleanup;
+                }
+
+                while ((nread = read(temp_fd, read_buf, read_chunk)) > 0) {
+                        size_t i;
+                        int modified = 0;
+                        for (i = 0; i < (size_t)nread; i++) {
+                                if ((unsigned char)read_buf[i] == 0x25) {  /* EBCDIC LF */
+                                        read_buf[i] = 0x15;  /* z/OS NL */
+                                        modified = 1;
+                                }
+                        }
+                        if (modified) {
+                                OFF_T write_offset = do_lseek(temp_fd, -nread, SEEK_CUR);
+                                if (write_offset < 0) {
+                                        rsyserr(FERROR_XFER, errno, "lseek back failed during newline fix for %s", full_fname(fname));
+                                        goto cleanup;
+                                }
+                                if (write(temp_fd, read_buf, nread) != nread) {
+                                        rsyserr(FERROR_XFER, errno, "write failed during newline fix for %s", full_fname(fname));
+                                        goto cleanup;
+                                }
+                        }
+                }
+        }
+
+        /* Copy converted data back to original file */
+        if (do_lseek(fd, 0, SEEK_SET) != 0 || do_lseek(temp_fd, 0, SEEK_SET) != 0) {
+                rsyserr(FERROR_XFER, errno, "lseek failed during CCSID conversion copy-back for %s", full_fname(fname));
+                goto cleanup;
+        }
+
+        while ((nread = read(temp_fd, read_buf, read_chunk)) > 0) {
+                if (write(fd, read_buf, nread) != nread) {
+                        rsyserr(FERROR_XFER, errno, "write failed during CCSID conversion copy-back for %s", full_fname(fname));
+                        goto cleanup;
+                }
+        }
+
+        /* Truncate to converted size */
+        if (do_ftruncate(fd, converted_total) < 0) {
+                rsyserr(FERROR_XFER, errno, "ftruncate failed after CCSID conversion of %s", full_fname(fname));
+                goto cleanup;
+        }
+
+        ret = 0; /* Success */
+
+cleanup:
+        if (converter != (iconv_t)-1)
+                iconv_close(converter);
+        if (read_buf)
+                free(read_buf);
+        if (converted_buf)
+                free(converted_buf);
+        if (temp_fd >= 0) {
+                close(temp_fd);
+                unlink(temp_fname);
+        }
+
+        return ret;
+}
+#endif
+#endif
