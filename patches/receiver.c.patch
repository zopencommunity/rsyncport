+#ifdef __MVS__
+#ifdef ICONV_CONST
+/* iconv handle for z/OS CCSID conversion */
+static iconv_t ic_zos_convert = (iconv_t)-1;
+static int zos_source_ccsid = 819; /* ASCII by default */
+static int zos_target_ccsid = 0;
+
+/* Convert data from source CCSID to target CCSID for z/OS */
+static char *convert_zos_ccsid(const char *data, int len, int *out_len, int target_ccsid)
+{
+	char *converted_buf = NULL;
+	size_t inleft, outleft, converted_len;
+	char *inbuf, *outbuf;
+	char ccsid_from[32], ccsid_to[32];
+	
+	if (target_ccsid == 0 || target_ccsid == 819 || target_ccsid == 1208) {
+		/* No conversion needed for ASCII or UTF-8 (compatible with ASCII) */
+		*out_len = len;
+		return (char *)data;
+	}
+	
+	/* Setup iconv for CCSID conversion - use proper charset names */
+	if (zos_source_ccsid == 819) {
+		snprintf(ccsid_from, sizeof(ccsid_from), "ISO8859-1");
+	} else {
+		snprintf(ccsid_from, sizeof(ccsid_from), "IBM-%d", zos_source_ccsid);
+	}
+	
+	if (target_ccsid == 819) {
+		snprintf(ccsid_to, sizeof(ccsid_to), "ISO8859-1");
+	} else {
+		snprintf(ccsid_to, sizeof(ccsid_to), "IBM-%d", target_ccsid);
+	}
+	
+	if (ic_zos_convert == (iconv_t)-1 || zos_target_ccsid != target_ccsid) {
+		if (ic_zos_convert != (iconv_t)-1)
+			iconv_close(ic_zos_convert);
+		
+		ic_zos_convert = iconv_open(ccsid_to, ccsid_from);
+		if (ic_zos_convert == (iconv_t)-1) {
+			rprintf(FERROR, "iconv_open(\"%s\", \"%s\") failed for z/OS CCSID conversion: %s\n",
+				ccsid_to, ccsid_from, strerror(errno));
+			*out_len = len;
+			return (char *)data;
+		}
+		zos_target_ccsid = target_ccsid;
+	}
+	
+	/* Allocate buffer for converted data (worst case: 4x expansion for multibyte) */
+	converted_len = len * 4;
+	converted_buf = new_array(char, converted_len);
+	
+	inbuf = (char *)data;
+	outbuf = converted_buf;
+	inleft = len;
+	outleft = converted_len;
+	
+	/* Reset conversion state */
+	iconv(ic_zos_convert, NULL, 0, NULL, 0);
+	
+	/* Perform conversion */
+	if (iconv(ic_zos_convert, &inbuf, &inleft, &outbuf, &outleft) == (size_t)-1) {
+		if (errno != E2BIG) {
+			rprintf(FERROR, "iconv conversion failed for z/OS CCSID %d: %s\n",
+				target_ccsid, strerror(errno));
+			free(converted_buf);
+			*out_len = len;
+			return (char *)data;
+		}
+	}
+	
+	*out_len = converted_len - outleft;
+	return converted_buf;
+}
+#endif
+#endif
