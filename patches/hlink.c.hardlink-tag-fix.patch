--- a/hlink.c
+++ b/hlink.c
@@ -38,6 +38,10 @@ extern int maybe_ATTRS_REPORT;
 extern int unsort_ndx;
 extern char *basis_dir[MAX_BASIS_DIRS+1];
 extern struct file_list *cur_flist;
+#ifdef __MVS__
+extern int preserve_zos_tags;
+extern int zos_tags_ndx;
+#endif
 
 #ifdef SUPPORT_HARD_LINKS
 
@@ -488,6 +492,26 @@ int hard_link_one(struct file_struct *file, const char *fname,
 		return 0;
 	}
 
+#ifdef __MVS__
+	/* On z/OS, hardlinks don't automatically inherit file tags (CCSID).
+	 * After creating the hardlink, explicitly copy the tag from the source file. */
+	if (preserve_zos_tags && zos_tags_ndx) {
+		/* z/OS system function to change file CCSID */
+		extern int __chgpathccsid(const char *, unsigned short);
+		
+		int source_ccsid = F_ZOS_CCSID(file);
+		if (DEBUG_GTE(HLINK, 1))
+			rprintf(FINFO, "[DEBUG] hard_link_one: %s -> %s, source_ccsid=%d\n",
+				fname, oldname, source_ccsid);
+		if (source_ccsid > 0) {
+			int rc = __chgpathccsid(fname, source_ccsid);
+			if (DEBUG_GTE(HLINK, 1))
+				rprintf(FINFO, "[DEBUG] __chgpathccsid(%s, %d) = %d\n",
+					fname, source_ccsid, rc);
+		}
+	}
+#endif
+
 	file->flags |= FLAG_HLINK_DONE;
 
 	return 1;
