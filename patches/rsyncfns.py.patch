+def can_bind_specific_port() -> bool:
+    """Runtime capability check: can we bind to a specific port?
+    
+    Some z/OS configurations have security policies that restrict binding to
+    specific ports, allowing only OS-assigned ephemeral ports. This function
+    performs a runtime check by attempting to bind to a high port number.
+    
+    Returns True if port binding works, False if restricted by security policy.
+    """
+    import socket
+    import random
+    
+    # Try a few high ports in case one is in use
+    for _ in range(5):
+        test_port = random.randint(50000, 60000)
+        try:
+            s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
+            s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
+            s.bind(('127.0.0.1', test_port))
+            s.close()
+            return True  # Successfully bound to specific port
+        except OSError as e:
+            if e.errno == errno.EADDRINUSE:
+                continue  # Port in use, try another
+            elif e.errno in (errno.EACCES, errno.EPERM):
+                # Permission denied - security policy restriction
+                return False
+            # Other errors - continue trying
+            continue
+        except Exception:
+            continue
+    
+    # If all attempts failed, assume restriction
+    return False
+
+
